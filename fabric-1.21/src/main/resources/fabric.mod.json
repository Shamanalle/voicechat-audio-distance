{
  "schemaVersion": 1,
  "id": "vc-audio-distance",
  "version": "${version}",
  "name": "VoiceChat Audio Distance",
  "icon": "assets/vc-audio-distance/icon.png",
  "description": "Shapes how Simple Voice Chat voices fade with distance and muffles them through walls. Live curve, wall preview and a monitor of who you hear.",
  "authors": [
    "Kasper"
  ],
  "contact": {
    "homepage": "https://github.com/Shamanalle/voicechat-audio-distance",
    "sources": "https://github.com/Shamanalle/voicechat-audio-distance",
    "issues": "https://github.com/Shamanalle/voicechat-audio-distance/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.kasper.vcdistance.AudioDistanceClient"
    ],
    "voicechat": [
      "com.kasper.vcdistance.AudioDistancePlugin"
    ],
    "modmenu": [
      "com.kasper.vcdistance.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": ">=1.21 <=1.21.11",
    "java": ">=21",
    "voicechat": ">=1.21-2.5.0"
  },
  "suggests": {
    "modmenu": "*"
  }
}
